{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperVisual IR",
  "type": "object",
  "required": [
    "title",
    "claim",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "language": {
      "enum": [
        "en",
        "zh"
      ],
      "default": "en",
      "description": "Intended language of reader-facing figure text. Existing text is not translated by the renderer."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "enum": [
        "default",
        "reference",
        "theory"
      ]
    },
    "panel_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "panel_descriptors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional reference-theme subheadings keyed by panel ID. Empty string hides a subheading."
    },
    "legend_labels": {
      "type": "object",
      "properties": {
        "blue": {
          "type": "string"
        },
        "green": {
          "type": "string"
        },
        "orange": {
          "type": "string"
        },
        "red": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Optional reference-theme legend labels for semantic role colors."
    },
    "show_crossrefs": {
      "type": "boolean",
      "default": true,
      "description": "In the reference theme, show mini-cards for actual incoming edges in single-node panels."
    },
    "review_status": {
      "enum": [
        "confirmed",
        "needs_review"
      ],
      "default": "needs_review"
    },
    "archetype": {
      "enum": [
        "auto",
        "pipeline",
        "compare",
        "hub_spoke",
        "timeline",
        "mechanism",
        "loop"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 600,
      "maximum": 4000
    },
    "height": {
      "type": "integer",
      "minimum": 600,
      "maximum": 4000
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "annotations": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role": {
            "enum": [
              "input",
              "process",
              "evidence",
              "output",
              "caveat",
              "core",
              "context"
            ]
          },
          "group": {
            "type": "string"
          },
          "panel": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "number"
          },
          "source": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "pages": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string"
                  },
                  "theorem": {
                    "type": "string"
                  },
                  "equation": {
                    "type": "string"
                  },
                  "explanation": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "pages"
                    ],
                    "properties": {
                      "pages": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "required": [
                      "section"
                    ],
                    "properties": {
                      "section": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "required": [
                      "theorem"
                    ],
                    "properties": {
                      "theorem": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "required": [
                      "equation"
                    ],
                    "properties": {
                      "equation": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "review_status": {
            "enum": [
              "confirmed",
              "needs_review"
            ],
            "default": "needs_review"
          },
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "assumptions": {
            "type": "string",
            "minLength": 1
          },
          "equality": {
            "type": "string",
            "minLength": 1
          },
          "emphasis": {
            "enum": [
              "normal",
              "main"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "sequence",
              "data",
              "causal",
              "feedback",
              "contrast",
              "association",
              "hierarchy",
              "proof_dependency",
              "specialization"
            ]
          },
          "label": {
            "type": "string"
          },
          "review_status": {
            "enum": [
              "confirmed",
              "needs_review"
            ],
            "default": "needs_review"
          },
          "source": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "pages": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string"
                  },
                  "theorem": {
                    "type": "string"
                  },
                  "equation": {
                    "type": "string"
                  },
                  "explanation": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "pages"
                    ],
                    "properties": {
                      "pages": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "required": [
                      "section"
                    ],
                    "properties": {
                      "section": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "required": [
                      "theorem"
                    ],
                    "properties": {
                      "theorem": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "required": [
                      "equation"
                    ],
                    "properties": {
                      "equation": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_source": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "pages": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "theorem": {
              "type": "string"
            },
            "equation": {
              "type": "string"
            },
            "explanation": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "pages"
              ],
              "properties": {
                "pages": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            {
              "required": [
                "section"
              ],
              "properties": {
                "section": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            {
              "required": [
                "theorem"
              ],
              "properties": {
                "theorem": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            {
              "required": [
                "equation"
              ],
              "properties": {
                "equation": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          ]
        }
      ]
    },
    "width_mm": {
      "type": "number",
      "minimum": 40,
      "maximum": 1000
    },
    "min_font_pt": {
      "type": "number",
      "minimum": 4,
      "maximum": 40
    },
    "dpi": {
      "type": "number",
      "minimum": 72,
      "maximum": 1200
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "style": {
            "const": "theory"
          }
        },
        "required": [
          "style"
        ]
      },
      "then": {
        "properties": {
          "nodes": {
            "contains": {
              "type": "object",
              "properties": {
                "emphasis": {
                  "const": "main"
                }
              },
              "required": [
                "emphasis"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "nodes": {
            "items": {
              "not": {
                "required": [
                  "formula"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
